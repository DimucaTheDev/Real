<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Real.Graphics.OpenGL\Real.Graphics.OpenGL.csproj" />
      <ProjectReference Include="..\Real.Graphics.Vulkan\Real.Graphics.Vulkan.csproj" />
      <ProjectReference Include="..\Real.Windowing.Glfw\Real.Windowing.Glfw.csproj" />
      <ProjectReference Include="..\Real\Real.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="shaders\main.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="shaders\main.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <PropertyGroup>
        <FmodProjectDir>$(MSBuildThisFileDirectory)..\Real.Fmod\</FmodProjectDir>
    </PropertyGroup>

    <!-- Debug -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == '' AND '$(Configuration)' == 'Debug'">
        <None Include="$(FmodProjectDir)runtimes\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>runtimes\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <Visible>false</Visible>
        </None>
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' AND '$(Configuration)' == 'Debug'">
        <FmodNativeFiles Include="$(FmodProjectDir)runtimes/$(RuntimeIdentifier)/native/*L.*" />
        <None Include="@(FmodNativeFiles)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <!-- Release -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != '' AND '$(Configuration)' == 'Release'">
        <FmodNativeFiles Include="$(FmodProjectDir)runtimes/$(RuntimeIdentifier)/native/*.*" Exclude="$(FmodProjectDir)runtimes/$(RuntimeIdentifier)/native/*L.*" />
        <None Include="@(FmodNativeFiles)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <!-- Гарантированное попадание в publish (single-file/self-contained игнорирует CopyToOutputDirectory) -->
    <Target Name="AddFmodNativeToPublish" BeforeTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(FmodNativeFiles)">
                <RelativePath>%(FmodNativeFiles.Filename)%(FmodNativeFiles.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
