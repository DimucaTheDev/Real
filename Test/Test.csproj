<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Real.Graphics.OpenGL\Real.Graphics.OpenGL.csproj" />
      <ProjectReference Include="..\Real.Graphics.Vulkan\Real.Graphics.Vulkan.csproj" />
      <ProjectReference Include="..\Real.Windowing.Glfw\Real.Windowing.Glfw.csproj" />
      <ProjectReference Include="..\Real\Real.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="shaders\main.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="shaders\main.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
